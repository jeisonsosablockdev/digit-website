{
  "version": "1.0.0",
  "labels": {
    "scope": [
      "scope:app",
      "scope:shared",
      "scope:docs",
      "scope:infra",
      "scope:security"
    ],
    "type": [
      "type:feature",
      "type:fix",
      "type:security",
      "type:refactor",
      "type:chore",
      "type:docs"
    ],
    "risk": [
      "risk:low",
      "risk:medium",
      "risk:high"
    ],
    "sizeExempt": "size-exempt",
    "branchAgeExempt": "branch-age-exempt"
  },
  "requiredPrSections": [
    "issue",
    "rfc",
    "riesgos",
    "rollback plan",
    "validation"
  ],
  "thresholds": {
    "maxAddedLines": 400,
    "maxBranchAgeDays": 3
  },
  "patterns": {
    "featureFlag": "feature[- ]flag",
    "commitMessage": "^(feat|fix|docs|chore|refactor|security|test|ci)\\((app|shared|docs|infra|security)\\): .+"
  },
  "canonicalCommands": {
    "preflight": "npm run pr:ready",
    "metadataLint": "npm run pr:metadata",
    "openPr": "npm run pr:open"
  }
}
